diff --git a/riscv/encoding.h b/riscv/encoding.h
index 5203544..56053eb 100644
--- a/riscv/encoding.h
+++ b/riscv/encoding.h
@@ -2556,6 +2556,22 @@
 #define MATCH_ZIP 0x8f01013
 #define MASK_ZIP 0xfff0707f
 
+/* === XBestISA (custom-0 / 0x0B) === */
+#define MATCH_BESTISA_SHA256CH  0x0000000b   /* funct2=00 funct3=000 */
+#define MASK_BESTISA_SHA256CH   0x0600707f
+#define MATCH_BESTISA_MAC       0x0000100b   /* funct2=00 funct3=001 */
+#define MASK_BESTISA_MAC        0x0600707f
+#define MATCH_BESTISA_XOR3      0x0000200b   /* funct2=00 funct3=010 */
+#define MASK_BESTISA_XOR3       0x0600707f
+#define MATCH_BESTISA_OR3       0x0000300b   /* funct2=00 funct3=011 */
+#define MASK_BESTISA_OR3        0x0600707f
+#define MATCH_BESTISA_SHA256MAJ 0x0200000b   /* funct2=01 funct3=000 */
+#define MASK_BESTISA_SHA256MAJ  0x0600707f
+#define MATCH_BESTISA_ADD3      0x0400000b   /* funct2=10 funct3=000 */
+#define MASK_BESTISA_ADD3       0x0600707f
+#define MATCH_BESTISA_LW        0x0000200b   /* funct7=0000000 funct3=010 */
+#define MASK_BESTISA_LW         0xfe00707f
+
 #define CSR_FFLAGS 0x1
 #define CSR_FRM 0x2
 #define CSR_FCSR 0x3
@@ -4139,6 +4155,15 @@ DECLARE_INSN(xperm32, MATCH_XPERM32, MASK_XPERM32)
 DECLARE_INSN(xperm4, MATCH_XPERM4, MASK_XPERM4)
 DECLARE_INSN(xperm8, MATCH_XPERM8, MASK_XPERM8)
 DECLARE_INSN(zip, MATCH_ZIP, MASK_ZIP)
+
+/* === XBestISA (custom-0 / 0x0B) === */
+DECLARE_INSN(bestisa_lw,        MATCH_BESTISA_LW,        MASK_BESTISA_LW)
+DECLARE_INSN(bestisa_sha256ch,  MATCH_BESTISA_SHA256CH,  MASK_BESTISA_SHA256CH)
+DECLARE_INSN(bestisa_mac,       MATCH_BESTISA_MAC,       MASK_BESTISA_MAC)
+DECLARE_INSN(bestisa_xor3,      MATCH_BESTISA_XOR3,      MASK_BESTISA_XOR3)
+DECLARE_INSN(bestisa_or3,       MATCH_BESTISA_OR3,       MASK_BESTISA_OR3)
+DECLARE_INSN(bestisa_sha256maj, MATCH_BESTISA_SHA256MAJ, MASK_BESTISA_SHA256MAJ)
+DECLARE_INSN(bestisa_add3,      MATCH_BESTISA_ADD3,      MASK_BESTISA_ADD3)
 #endif
 #ifdef DECLARE_CSR
 DECLARE_CSR(fflags, CSR_FFLAGS)
